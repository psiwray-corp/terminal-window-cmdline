# Adapted from libvterm t/22state_save.test (MIT, see LICENSE beside this file).
# Pen, cursor-shape, and terminal-property expectations are removed; this
# section saves and restores cursor position.
INIT
WANTSTATE p

RESET

!Set up state
PUSH "\e[2;2H"
  ?cursor = 1,1

!Save
PUSH "\e[?1048h"

!Change state
PUSH "\e[5;5H"
  ?cursor = 4,4

!Restore
PUSH "\e[?1048l"
  ?cursor = 1,1

!Save/restore using DECSC/DECRC
PUSH "\e[2;2H\e7"
  ?cursor = 1,1

PUSH "\e[5;5H"
  ?cursor = 4,4
PUSH "\e8"
  ?cursor = 1,1

!Save twice, restore twice happens on both edge transitions
PUSH "\e[2;10H\e[?1048h\e[6;10H\e[?1048h"
PUSH "\e[H"
  ?cursor = 0,0
PUSH "\e[?1048l"
  ?cursor = 5,9
PUSH "\e[H"
  ?cursor = 0,0
PUSH "\e[?1048l"
  ?cursor = 5,9
